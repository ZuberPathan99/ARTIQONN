# Set to the verified public HTTPS origin before production deployment.
# On Netlify, URL is used automatically when VITE_SITE_URL is absent.
VITE_SITE_URL=
# Optional verified business contact details. These are public values.
VITE_CONTACT_EMAIL=hello@artiqonn.com
VITE_INSTAGRAM_HANDLE=artiqonn
VITE_CONTACT_PHONE=
# Local previews never send inquiries. Enable on Netlify after enabling Forms.
VITE_CONTACT_ENABLED=false
